{% extends 'base.html.twig' %}

{% block title %}Administrer les Réseaux - Compétences{% endblock %}

{% block body %}
    <div class="container">
        <div class="jumbotron text-center bg-light p-5 rounded mb-4">
            <h1 class="display-4">Administrer les Réseaux et l'Internet</h1>
            <p class="lead">Expertise en architecture réseau et administration.</p>
        </div>

        <div class="row mb-5">
            <div class="col-12">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-primary">
                            <tr>
                                <th class="text-center">Compétences</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-center">Maîtriser les lois fondamentales de l'électricité</td>
                            </tr>
                            <tr>
                                <td class="text-center">Comprendre l'architecture et les fondements des systèmes informatiques</td>
                            </tr>
                            <tr>
                                <td class="text-center">Configurer les fonctions de base du réseau</td>
                            </tr>
                            <tr>
                                <td class="text-center">Maîtriser les rôles et les principes fondamentaux des systèmes d'exploitation</td>
                            </tr>
                            <tr>
                                <td class="text-center">Savoir identifier les configurations réseau</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="row mb-5">
            <div class="col-12 text-center">
                <a class="btn btn-primary btn-lg" href="{{ path('app_portfolio') }}#analysis-rt1">Voir Analyse</a>
            </div>
        </div>

        {# Navigation entre les pages #}
        <div class="row mb-5">
            <div class="col-12">
                <nav class="d-flex justify-content-between align-items-center">
                    <a href="{{ path('app_skills') }}" class="btn btn-secondary">Retour aux Compétences</a>
                    <div>
                        <a href="{{ path('app_skills_connecter') }}" class="btn btn-success">Connecter →</a>
                    </div>
                </nav>
            </div>
        </div>
    </div>

    {# Modal Analyse #}
    <div class="modal fade" id="modal-analyse" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Administrer les Réseaux - Analyse</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <h6 class="mb-3">Analyse Réflexive</h6>
                    <table class="table table-bordered mb-4">
                        <tbody>
                            <tr><td style="height: 150px;"></td></tr>
                        </tbody>
                    </table>
                    <h6 class="mb-3">Document de Preuve</h6>
                    <table class="table table-bordered">
                        <tbody>
                            <tr><td style="height: 150px;"></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
